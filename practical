class Student {
    int rollNo;
    String name;
    int m1, m2, m3;

    Student(int rollNo, String name, int m1, int m2, int m3) {
        this.rollNo = rollNo;
        this.name = name;
        this.m1 = m1;
        this.m2 = m2;
        this.m3 = m3;
    }

    int totalMarks() {
        return m1 + m2 + m3;
    }

    double percentage() {
        return totalMarks() / 3.0;
    }

    void display() {
        System.out.println("Roll No: " + rollNo);
        System.out.println("Name: " + name);
        System.out.println("Total Marks: " + totalMarks());
        System.out.println("Percentage: " + percentage() + "%");
        System.out.println();
    }

    public static void main(String[] args) {
        Student s1 = new Student(1, "Aman", 80, 85, 90);
        Student s2 = new Student(2, "Riya", 75, 88, 82);
        Student s3 = new Student(3, "Rahul", 90, 92, 87);

        s1.display();
        s2.display();
        s3.display();
    }
}
